{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "github_core Collection Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "sources",
    "edges"
  ],
  "properties": {
    "manifest_version": {
      "type": "string",
      "enum": [
        "0"
      ]
    },
    "description": {
      "type": "string"
    },
    "api_base_url": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "rest_endpoint",
              "repo_file",
              "custom_fn"
            ]
          },
          "path": {
            "type": "string"
          },
          "path_pattern": {
            "type": "string"
          },
          "fallback_path": {
            "type": "string"
          },
          "query": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "item_path": {
            "type": "string"
          },
          "target_entity_type": {
            "type": "string"
          },
          "target_field": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "permission_failure": {
            "enum": [
              "abort",
              "degrade_with_warning"
            ]
          },
          "description": {
            "type": "string"
          },
          "permission": {
            "type": "string",
            "pattern": "^(repository|organization):[a-z_]+:(read|write)$",
            "description": "The GitHub permission this source requires, as the canonical triple `<surface>:<key>:<level>` (e.g. `repository:actions:read`). The credential's least-privilege set \u2014 for a fine-grained PAT and for the App manifest alike \u2014 is the union over sources. Derived once, never restated."
          },
          "permission_not_applicable": {
            "type": "string",
            "minLength": 1,
            "description": "Why this source needs no repository/organization permission triple \u2014 the narrow, stated exemption for an endpoint that is not a grant over anybody's resources (e.g. `/app/installations`, which is App-JWT-level and describes the App itself). Sources without a triple contribute nothing to the derived least-privilege set, so the exemption must be declared rather than achieved by omission: a silently missing `permission` would quietly narrow what the credential is allowed to see."
          }
        },
        "anyOf": [
          {
            "required": [
              "permission"
            ]
          },
          {
            "required": [
              "permission_not_applicable"
            ]
          }
        ]
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slug",
          "source",
          "target"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[A-Z][A-Z_]+__[a-z0-9_]+$"
          },
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "condition": {
            "type": "string"
          }
        }
      }
    }
  }
}
