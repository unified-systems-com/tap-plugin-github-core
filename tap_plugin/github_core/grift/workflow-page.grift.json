            "dimensions": {}
          },
          "node": {
            "name": "github_core — runs of one workflow, newest first",
            "description": "Every collected run this workflow executed, in the collected window; the table sorts them newest first (a multi-hop match cannot ORDER BY, req-grid-gryphon-order-by-envelope) (req-github-core-workflow-page-3).",
            "search_type": "gryphon",
            "root": "node",
            "definition": {
              "query": [
                "MATCH (w:github_core__github_workflow)<-[:EXECUTES_WORKFLOW__github_core]-(r:github_core__github_actions_run)",
                "WHERE w.data.full_name = $repo AND w.data.path CONTAINS $workflow",
                "RETURN r"
              ]
            },
            "input_schema": {
              "type": "object",
              "properties": {
                "repo": {
                  "type": "string",
                  "description": "The repository's full_name (owner/name), from the page URL ?repo=… — required."
                },
                "workflow": {
                  "type": "string",
                  "description": "The workflow file, by path or file name (`.github/workflows/product-lines.yml` or `product-lines.yml`), from ?workflow=… — required. Matched by CONTAINS on the collected path, so give the file name with its extension."
                }
