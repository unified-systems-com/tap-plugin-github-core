      "batch_node": {
        "source": "tap_plugin.github_core.grift.workflow_page",
        "name": "GitHub Core Workflow Page v0.1.0",
        "description": "The generic workflow-and-job viewer (spec-github-core-workflow-page-v0.md): /github_core/workflow?repo=owner/name&workflow=<file> — identity, anatomy (jobs ranked over needs with steps inside and artifact piles per declared kind), recent runs. One page node, three panels, four searches, and the anatomy projection with its elevation and layout. Every search takes repo + workflow as required inputs; nothing here names a repository."
      },
      "nodes": [
        {
          "entity": {
            "entity_id": "01a0887c-31bf-7584-9d80-739a3ef3e96f",
            "entity_type": "page",
            "name": "GitHub workflow",
            "dimensions": {
              "tap.graph": "web"
            }
          },
          "node": {
            "name": "GitHub workflow",
            "description": "ONE workflow, read top to bottom (req-github-core-workflow-page): who it is (path, state, triggers, permissions), its anatomy — the jobs ranked over `needs:` with their steps inside, and the artifact kinds each job's upload step declares as piles counted from the runs in the collected window — then its recent runs. Generic: ?repo=owner/name&workflow=<file> select the workflow; the page names no repository. Not in the top nav; the machinery view and the repository page are the ways in.",
            "slug": "/github_core/workflow",
            "discoverable": false,
            "layout": {
              "full_bleed": true,
              "columns": {
                "col-1": {
                  "width": "1fr",
                  "rows": {
                    "row-1": {
                      "panel-id": "identity",
                      "height": "auto"
                    },
                    "row-2": {
                      "panel-id": "anatomy",
                      "height": "60vh"
                    },
                    "row-3": {
                      "panel-id": "runs",
                      "height": "auto"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "entity": {
            "entity_id": "01a0887c-31bf-7584-9d80-739e4f9a3170",
            "entity_type": "search",
            "name": "github_core — workflow by repository and file",
            "dimensions": {}
          },
          "node": {
            "name": "github_core — workflow by repository and file",
            "description": "The workflow the page is about (req-github-core-workflow-page-1). Envelope mode so the identity table receives the node with its typed fields.",
            "search_type": "gryphon",
            "root": "node",
            "definition": {
              "query": [
                "MATCH (w:github_core__github_workflow)",
                "WHERE w.data.full_name = $repo AND w.data.path CONTAINS $workflow",
                "RETURN w"
              ]
            },
            "input_schema": {
              "type": "object",
              "properties": {
                "repo": {
                  "type": "string",
                  "description": "The repository's full_name (owner/name), from the page URL ?repo=… — required."
                },
                "workflow": {
                  "type": "string",
                  "description": "The workflow file, by path or file name (`.github/workflows/product-lines.yml` or `product-lines.yml`), from ?workflow=… — required. Matched by CONTAINS on the collected path, so give the file name with its extension."
                }
              },
              "required": [
                "repo",
                "workflow"
              ]
            }
          }
        },
        {
          "entity": {
            "entity_id": "01a0887c-31bf-7584-9d80-739bbf5509d4",
            "entity_type": "panel",
            "name": "Workflow",
            "dimensions": {
              "tap.graph": "web"
            }
          },
          "node": {
            "name": "Workflow",
            "description": "The workflow's identity row: file, state, what starts it, the permissions its file grants, and the link to GitHub (req-github-core-workflow-page-2).",
            "slug": "github-workflow-identity",
            "view": "tap_web/panels/table_panel.html",
            "config": {
              "default_page_size": 1,
              "columns": [
                {
                  "field": "data.name",
                  "title": "Workflow",
                  "widthGrow": 2,
                  "formatter": "link",
                  "formatter_params": {
                    "href_field": "data.html_url"
                  },
                  "header_tooltip": "The workflow's display name. Opens it on GitHub."
                },
                {
                  "field": "data.path",
                  "title": "File",
                  "widthGrow": 2,
                  "header_tooltip": "The workflow file under .github/workflows."
                },
                {
                  "field": "data.state",
                  "title": "State",
                  "width": 100,
                  "header_tooltip": "GitHub's workflow state: active, disabled, or a dynamic workflow GitHub owns."
                },
                {
                  "field": "data.configuration.triggers",
                  "title": "Starts on",
                  "widthGrow": 2,
                  "formatter": "list",
                  "header_tooltip": "The trigger events declared in the file."
                },
                {
                  "field": "data.configuration.permissions",
                  "title": "Permissions",
                  "widthGrow": 2,
                  "formatter": "json",
                  "header_tooltip": "The token permissions the file grants at the top level. Jobs may narrow or widen them."
                }
              ]
            }
          }
        },
        {
          "entity": {
            "entity_id": "01a0887c-31bf-7584-9d80-739f392dfaaf",
            "entity_type": "search",
            "name": "github_core — workflow page: anatomy scene (the workflow and its jobs)",
