        {
          "entity": {
            "entity_id": "01a0887c-31bf-7584-9d80-739d26baab9f",
            "entity_type": "panel",
            "name": "Runs",
            "dimensions": {
              "tap.graph": "web"
            }
          },
          "node": {
            "name": "Runs",
            "description": "This workflow's runs in the collected window, newest first: what started each, its conclusion, how long it took, when. The workflow's own status wall (req-github-core-workflow-page-3).",
            "slug": "github-workflow-runs",
            "view": "tap_web/panels/table_panel.html",
            "config": {
              "default_page_size": 50,
              "quick_filter": true,
              "refresh_seconds": 300,
              "columns": [
                {
                  "field": "data.event",
                  "title": "",
                  "width": 40,
                  "headerSort": false,
                  "formatter": "iconMap",
                  "formatter_params": {
                    "icons": {
                      "push": "/static/tap_web/icons/trigger-push.svg",
                      "pull_request": "/static/tap_web/icons/trigger-pull-request.svg",
                      "pull_request_target": "/static/tap_web/icons/trigger-pull-request.svg",
                      "schedule": "/static/tap_web/icons/trigger-schedule.svg",
                      "workflow_dispatch": "/static/tap_web/icons/trigger-manual.svg",
                      "workflow_run": "/static/tap_web/icons/trigger-chained.svg",
                      "workflow_call": "/static/tap_web/icons/trigger-chained.svg",
                      "dynamic": "/static/tap_web/icons/trigger-platform.svg",
                      "repository_dispatch": "/static/tap_web/icons/trigger-manual.svg"
                    },
                    "labels": {
                      "push": "push",
                      "pull_request": "pull request",
                      "pull_request_target": "pull request target",
                      "schedule": "schedule",
                      "workflow_dispatch": "workflow dispatch",
                      "workflow_run": "workflow run",
                      "workflow_call": "workflow call",
                      "dynamic": "dynamic",
                      "repository_dispatch": "repository dispatch"
                    }
                  },
                  "header_tooltip": "What started the run."
                },
                {
                  "field": "data.run_number",
                  "title": "Run",
                  "width": 80,
                  "formatter": "link",
                  "formatter_params": {
                    "href_field": "data.html_url"
                  },
                  "header_tooltip": "GitHub's run number. Opens the run on GitHub."
                },
                {
                  "field": "data.head_branch",
                  "title": "Branch",
                  "widthGrow": 2,
                  "tooltip": "full_value",
                  "header_tooltip": "The branch or ref the run built."
                },
                {
                  "field": "data.conclusion",
                  "title": "Conclusion",
                  "formatter": "conclusionBadge",
                  "width": 120,
                  "header_tooltip": "GitHub's terminal conclusion; blank while the run is in progress."
                },
                {
                  "field": "data.completed_at",
                  "title": "Elapsed",
                  "formatter": "elapsed",
                  "width": 100,
                  "formatter_params": {
                    "start": "data.run_started_at",
                    "end": "data.completed_at",
                    "require_field": "data.completed_at"
                  },
                  "header_tooltip": "Wall-clock time from start to completion."
                },
                {
                  "field": "data.completed_at",
                  "title": "vs usual",
                  "formatter": "baselineRatio",
                  "width": 90,
                  "formatter_params": {
                    "start": "data.run_started_at",
                    "end": "data.completed_at",
                    "require_field": "data.conclusion",
                    "baseline": {
                      "group_by": [
                        "data.event"
                      ],
                      "where": {
                        "data.conclusion": "success"
                      },
                      "min_n": 3,
                      "flag_ratio": 1.5,
                      "mad_k": 3
                    }
                  },
                  "header_tooltip": "This run's elapsed over the median of this workflow's other successful runs with the same trigger. ▲ slower, ▼ faster, plain = within, – = not enough history (see n)."
                },
                {
                  "field": "data.completed_at",
                  "title": "n",
                  "formatter": "baselineN",
                  "width": 55,
                  "formatter_params": {
                    "start": "data.run_started_at",
                    "end": "data.completed_at",
                    "require_field": "data.conclusion",
                    "baseline": {
                      "group_by": [
                        "data.event"
                      ],
                      "where": {
                        "data.conclusion": "success"
                      },
                      "min_n": 3,
                      "flag_ratio": 1.5,
                      "mad_k": 3
                    }
                  },
                  "header_tooltip": "Comparable runs (same trigger, successful) loaded on this page to form the baseline; grey below 3."
                },
                {
                  "field": "data.run_started_at",
                  "title": "Started",
                  "formatter": "datetime",
                  "widthGrow": 1,
                  "header_tooltip": "When the run started, in your local time. Hover for UTC."
                },
                {
                  "field": "data.completed_at",
                  "title": "Completed",
                  "formatter": "datetime",
                  "widthGrow": 1,
                  "header_tooltip": "When the run completed, in your local time. Hover for UTC."
                }
              ]
            }
          }
        },
